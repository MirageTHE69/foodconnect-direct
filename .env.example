# Copy this file to .env and fill in values from your Supabase project
# (Project Settings > API in the Supabase dashboard).

SUPABASE_PUBLISHABLE_KEY=""
SUPABASE_URL=""
VITE_SUPABASE_PROJECT_ID=""
VITE_SUPABASE_PUBLISHABLE_KEY=""
VITE_SUPABASE_URL=""

# "sandbox" or "production" -- controls which Cashfree Drop-in SDK environment
# loads client-side. The actual API keys (CASHFREE_APP_ID, CASHFREE_SECRET_KEY,
# CASHFREE_WEBHOOK_SECRET, CASHFREE_ENV) are server-only and set via
# `supabase secrets set`, never in this file.
VITE_CASHFREE_ENV="sandbox"
