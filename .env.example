# Copy this file to .env and fill in values from your Supabase project
# (Project Settings > API in the Supabase dashboard).

SUPABASE_PUBLISHABLE_KEY=""
SUPABASE_URL=""
VITE_SUPABASE_PROJECT_ID=""
VITE_SUPABASE_PUBLISHABLE_KEY=""
VITE_SUPABASE_URL=""

# Razorpay credentials (RAZORPAY_KEY_ID, RAZORPAY_KEY_SECRET,
# RAZORPAY_WEBHOOK_SECRET) are server-only and set via `supabase secrets
# set`, never in this file -- the public Key ID is returned to the client
# by the create-payment-order edge function, not read from a build-time env
# var.
